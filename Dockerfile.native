# Native image: UI + API in one binary. Cap heap for 4GB docker --memory.
# Pin ol9: tag :25 tracks OL10 (glibc x86-64-v3). NAS/Gitea runners are often v2.
FROM ghcr.io/graalvm/native-image-community:25-ol9 AS build
WORKDIR /app
USER root
ENV MAVEN_OPTS="-Xmx768m"
ENV NATIVE_IMAGE_JAVA_OPTIONS="-Xmx2800m"

COPY mvnw pom.xml ./
COPY .mvn .mvn
COPY note-keeper-service/pom.xml note-keeper-service/
COPY note-keeper-web/pom.xml note-keeper-web/
RUN chmod +x mvnw && ./mvnw -B -q dependency:go-offline || true

COPY . .
# Boot 4.1 native profile does not bind native-image to package. Install web, then native:compile.
RUN chmod +x mvnw \
    && ./mvnw -B -DskipTests -pl note-keeper-web -am install \
    && ./mvnw -B -Pnative -DskipTests -DskipNativeBuild=false -Dnative.image.maxHeap=2800m -pl note-keeper-service native:compile \
    && ls -la note-keeper-service/target \
    && BIN="$(ls note-keeper-service/target/note-keeper note-keeper-service/target/note-keeper-service 2>/dev/null | head -n1)" \
    && test -n "$BIN" && cp "$BIN" /note-keeper

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /note-keeper /app/note-keeper
EXPOSE 8080
ENTRYPOINT ["/app/note-keeper", "-Djavax.xml.accessExternalDTD=all", "--spring.config.location=file:/app/etc/application.yaml"]
